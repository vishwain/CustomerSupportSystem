# Copy to .env and fill in. .env is never committed.
OPENROUTER_API_KEY=your_key_here
# Only ':free' model ids are allowed (NFR-07). src/llm.py refuses others unless ALLOW_PAID_MODEL=1.
MODEL_NAME=nvidia/nemotron-3.5-lightning:free
LLM_REASONING=off
LLM_TIMEOUT_S=10
LLM_MIN_INTERVAL_S=3
# 1 = cache provider responses by prompt hash in storage/llm_cache (development only)
LLM_CACHE=0
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
LOG_LEVEL=INFO
# Routing threshold and retrieval cutoff live in config/routing.json and config/retrieval.json,
# set from data by docs/routing_threshold.py and docs/retrieval_experiment.py. Not set here.
