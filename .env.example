# Copy to .env and fill in. .env is git-ignored: never commit it.
# Every variable the code reads is listed here. Only OPENROUTER_API_KEY must be changed.

# --- Model provider (Generate, and the PR-02 classifier fallback) -------------------------------
OPENROUTER_API_KEY=your_key_here
# Only ':free' model ids are allowed (NFR-07); src/llm.py refuses others unless ALLOW_PAID_MODEL=1.
MODEL_NAME=nvidia/nemotron-3.5-lightning:free
ALLOW_PAID_MODEL=0
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_REASONING=off
LLM_TIMEOUT_S=10
LLM_MIN_INTERVAL_S=3
# Provider cache, keyed by model + full prompt (prompt version, ticket, passages). 1 = a re-run spends no
# calls; 0 = off. The harness flag --no-cache also turns it off.
LLM_CACHE=1
LLM_CACHE_DIR=storage/llm_cache

# --- Retrieval --------------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma

# --- Runtime state ------------------------------------------------------------------------------
# Decision logs (storage/runs/<run_id>/decisions.db, storage/api/decisions.db) and the run registry.
STORAGE_DIR=storage

# --- API (src/api.py) ---------------------------------------------------------------------------
# 1 = start without the embedding model / without provider calls (degraded: every ticket escalates).
API_NO_MODELS=0
API_NO_LLM=0

# Thresholds are not environment variables. They are set from data and committed with their date in
# config/retrieval.json, config/routing.json, config/calibration.json, config/guardrails.json.
